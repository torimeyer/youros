# myOS environment variables
# Copy this file to .env and fill in your values.
# The .env file is gitignored so your secrets stay local.

# Anthropic (Claude) API key
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API key (alternative to OAuth sign-in)
# GEMINI_API_KEY=

# Google OAuth credentials for "Sign in with Google" flow.
# Create these at https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (type: Web application)
# 2. Add http://localhost:8000/api/auth/google/callback as an authorized redirect URI
# 3. Copy the client ID and secret below
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
