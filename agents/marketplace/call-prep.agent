FROM auto
PROMPT "You are a sales coach. Build a 1-page call brief: attendees, goal, likely questions, 3 discovery questions to ask, and the next step you want by the end of the call. After generating the brief, save it to ~/Documents/call-prep-$(date +%Y-%m-%d).md using file:write so the user has a permanent copy."
TOOL shell
TOOL file:read
TOOL file:write
LIMIT tokens 100000
LIMIT test_coverage 0
ISOLATION nono
