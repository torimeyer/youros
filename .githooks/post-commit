#!/usr/bin/env bash
# Post-commit hook to automatically close needles when commit message contains →NNNN
# Idempotent: closing already-closed needles is silent ok.
# Never blocks commits: always exits 0 even on errors.
#
# Auto-close ONLY fires for fix-shaped commit types: fix, feat, perf, refactor.
# docs, test, chore, style, ci, build commits may reference needles (e.g.
# "filed →NNN", "see →NNN") without triggering close — they are tracking
# mentions, not resolutions.

set -u

# Get the latest commit message
msg=$(git log -1 --pretty=%B 2>/dev/null || true)

# Extract the subject line (first line) and check its Conventional Commit type.
# Only fix/feat/perf/refactor subjects may auto-close needles.
subject=$(echo "$msg" | head -1)
commit_type=$(echo "$subject" | sed -n 's/^\([a-z][a-z]*\)[:(].*/\1/p' | tr '[:upper:]' '[:lower:]')

case "$commit_type" in
  fix|feat|perf|refactor) ;;  # allowed — proceed to close
  *)
    # docs/test/chore/style/ci/build/etc. — needle refs are mentions, not closes
    exit 0
    ;;
esac

# Find all →NNN or →NNNN patterns (2-4 digits) in the SUBJECT LINE ONLY and close them.
# Body lines may mention needles for context ("this addresses →NNN", "found in →NNN")
# without those needles being resolutions — scanning only the subject prevents false closes.
if [ -n "$subject" ]; then
  while IFS= read -r needle; do
    if [ -n "$needle" ]; then
      # Run ostk work close, silently ignore if already closed or error
      if ostk work close "$needle" 2>/dev/null | grep -q "closed"; then
        echo "Auto-closed $needle"
        # Sync the close to the myOS Tasks backend. The API uses bare
        # numeric IDs in URLs (no → prefix) to avoid Unicode in paths.
        # Look up the real task_id first, then close by that bare ID.
        _bare="${needle#→}"
        _task_json=$(curl -sk --connect-timeout 2 -m 4 \
          "https://127.0.0.1:8000/api/tasks/by-needle/${_bare}" 2>/dev/null || echo "")
        _task_id=$(echo "$_task_json" | python3 -c \
          "import sys,json; print(json.load(sys.stdin).get('task_id',''))" 2>/dev/null || echo "")
        if [ -n "$_task_id" ]; then
          curl -sk --connect-timeout 2 -m 4 -X POST \
            "https://127.0.0.1:8000/api/tasks/${_task_id}/close" \
            -H "Content-Type: application/json" \
            -d '{"reason":"completed"}' \
            >/dev/null 2>&1 || true
        fi
      fi
    fi
  done < <(echo "$subject" | grep -oE '→[0-9]{2,4}' | sort -u)
fi

exit 0
