#!/usr/bin/env bash
# Post-commit hook to automatically close needles when commit message contains →NNNN
# Idempotent: closing already-closed needles is silent ok.
# Never blocks commits: always exits 0 even on errors.
#
# Auto-close ONLY fires for fix-shaped commit types (configurable via rules.json).
# Default: fix, feat, perf, refactor.

set -u

# Load subject_types_close from rules.json (with fallback to hardcoded defaults).
_REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
_DEFAULTS="${_REPO_ROOT}/.claude/hooks/lib/default-rules.json"
_USER_RULES="${HOME}/.myos/rules.json"
SUBJECT_TYPES=$(python3 -c "
import json, os, sys
def load(p):
    try:
        with open(p) as f: return json.load(f)
    except: return {}
def deep_merge(a, b):
    out = dict(a)
    for k, v in b.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict): out[k] = deep_merge(out[k], v)
        else: out[k] = v
    return out
try:
    cfg = deep_merge(load('${_DEFAULTS}'), load(os.path.expanduser('${_USER_RULES}')))
    types = cfg.get('rules',{}).get('post_commit_auto_close',{}).get('subject_types_close', ['fix','feat','perf','refactor'])
    print('|'.join(str(t) for t in types))
except Exception:
    print('fix|feat|perf|refactor')
" 2>/dev/null || echo "fix|feat|perf|refactor")

# Get the latest commit message
msg=$(git log -1 --pretty=%B 2>/dev/null || true)

# Extract the subject line (first line) and check its Conventional Commit type.
subject=$(echo "$msg" | head -1)
commit_type=$(echo "$subject" | sed -n 's/^\([a-z][a-z]*\)[:(].*/\1/p' | tr '[:upper:]' '[:lower:]')

# Gate: only proceed for allowed commit types
if ! echo "|${SUBJECT_TYPES}|" | grep -qF "|${commit_type}|"; then
    exit 0
fi

# Find all →NNN or →NNNN patterns (2-4 digits) in the SUBJECT LINE ONLY and close them.
if [ -n "$subject" ]; then
  while IFS= read -r needle; do
    if [ -n "$needle" ]; then
      if ostk work close "$needle" 2>/dev/null | grep -q "closed"; then
        echo "Auto-closed $needle"
        _bare="${needle#→}"
        _task_json=$(curl -sk --connect-timeout 2 -m 4 \
          "https://127.0.0.1:8000/api/tasks/by-needle/${_bare}" 2>/dev/null || echo "")
        _task_id=$(echo "$_task_json" | python3 -c \
          "import sys,json; print(json.load(sys.stdin).get('task_id',''))" 2>/dev/null || echo "")
        if [ -n "$_task_id" ]; then
          curl -sk --connect-timeout 2 -m 4 -X POST \
            "https://127.0.0.1:8000/api/tasks/${_task_id}/close" \
            -H "Content-Type: application/json" \
            -d '{"reason":"completed"}' \
            >/dev/null 2>&1 || true
        fi
      fi
    fi
  done < <(echo "$subject" | grep -oE '→[0-9]{2,4}' | sort -u)
fi

exit 0
