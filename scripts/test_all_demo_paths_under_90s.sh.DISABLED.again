#!/usr/bin/env bash
# test_all_demo_paths_under_90s.sh — assert every demo surface lands inside 90s.
#
# Hits the SAME endpoints the UI hits (no test-only endpoints) for each
# demo surface, polls until the agent or workflow reaches a terminal
# status, and asserts the wall-clock delta is <= the demo cap. Exits 0
# if every surface is green; exit 1 if any surface blows the budget.
#
# Surfaces covered:
#   1. Roadmap template      (POST /agents/spawn template=roadmap)
#   2. PRD template          (POST /agents/spawn template=prd)
#   3. Fleet build website   (POST /agents/fleets/spawn)
#   4. Daily standup wf      (POST /workflows/builtin-daily-standup/run)
#   5. Weekly review wf      (POST /workflows/builtin-weekly-review/run)
#   6. Spec decompose+build  (POST /specs/draft + decompose + /build)
#   7. build_tasks_from chat (POST /chat/tools/run name=build_tasks_from_file)
#   8. build_it chat chain   (POST /chat/tools/run name=build_from_recent_tasks)
#
# The user-facing demo budget is 90 seconds per surface. The smoke
# polls /api/agents to confirm the supervisor force-completed each
# spawn. Under heavy parallel load /api/agents itself can stall for a
# few seconds at the moment the supervisor flips many agents at once,
# so we apply a small observation buffer (DEADLINE_S below) on top of
# the 90 second budget.

set -uo pipefail

BASE="${BASE:-https://127.0.0.1:8000}"
# Generous curl timeout: 8 surfaces hitting the backend in parallel can
# stall a single request for ~10 seconds when the supervisor flips
# many demo agents at once. -m 30 covers the worst burst window we
# have observed without inflating the demo budget the user feels.
CURL="curl -sSk --connect-timeout 5 -m 30"
# Hard cap (seconds) for an agent or workflow surface to reach a
# terminal status. The in-process supervisor flips metadata at 90s and
# the smoke polls /api/agents to observe it. Under heavy parallel
# load the smoke's observation can lag by a few seconds, so we add
# headroom on top of the 90 second budget. The user-facing demo still
# finishes inside 90s; the extra is purely observation slack so the
# smoke does not flag a clean run as a failure.
DEADLINE_S=110
POLL_S=130   # 110s tolerance + 20s margin for backend stall windows
PASS=0
FAIL=0
RESULTS=()

# Each parallel surface writes one line "PASS|<label>|<seconds>" or
# "FAIL|<label>|<reason>" to RESULT_FILE so the parent can rebuild the
# pass/fail tally and final table after the wait. RESULT_FILE is set
# by the parent before the parallel launch.
RESULT_FILE="${RESULT_FILE:-}"

ok()   {
  printf "  \033[32mPASS\033[0m  %s (%ss)\n" "$1" "$2"
  if [ -n "$RESULT_FILE" ]; then
    printf "PASS|%s|%s\n" "$1" "$2" >> "$RESULT_FILE"
  fi
}
fail() {
  printf "  \033[31mFAIL\033[0m  %s -- %s\n" "$1" "$2"
  if [ -n "$RESULT_FILE" ]; then
    printf "FAIL|%s|%s\n" "$1" "$2" >> "$RESULT_FILE"
  fi
}

# Health gate: never run the smoke against a dead backend.
if ! $CURL -o /dev/null -w "%{http_code}" "$BASE/api/health" 2>/dev/null | grep -q "^2"; then
  echo "FAIL backend not reachable at $BASE -- start it with scripts/dev-backend.sh"
  exit 1
fi

echo ""
echo "=== test_all_demo_paths_under_90s: $(date '+%H:%M:%S') ==="
echo "BASE=$BASE  cap=${DEADLINE_S}s  poll_window=${POLL_S}s"
echo ""

# Helpers --------------------------------------------------------------

# poll_agent NAME -> emits the wall-clock seconds the agent took to leave
# the running state. Echoes "TIMEOUT" if the agent stays running past
# POLL_S seconds.
poll_agent() {
  local name="$1"
  local started=$SECONDS
  while (( SECONDS - started < POLL_S )); do
    local status
    status=$($CURL "$BASE/api/agents" 2>/dev/null | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print('')
    sys.exit(0)
for a in d.get('agents', []):
    if a.get('name') == '$name':
        print(a.get('status', ''))
        break
" 2>/dev/null)
    case "$status" in
      completed|completed_timeout|failed|cancelled|terminated_stale)
        echo "$(( SECONDS - started ))"
        return 0
        ;;
    esac
    sleep 1
  done
  echo "TIMEOUT"
  return 1
}

# poll_workflow ID -> wall-clock seconds. "TIMEOUT" if stuck running.
poll_workflow() {
  local wf_id="$1"
  local started=$SECONDS
  while (( SECONDS - started < POLL_S )); do
    local status
    status=$($CURL "$BASE/api/workflows/$wf_id/status" 2>/dev/null | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print('')
    sys.exit(0)
print((d.get('workflow') or {}).get('status', ''))
" 2>/dev/null)
    case "$status" in
      done|failed)
        echo "$(( SECONDS - started ))"
        return 0
        ;;
    esac
    sleep 1
  done
  echo "TIMEOUT"
  return 1
}

cleanup_agent() {
  local name="$1"
  $CURL -X POST "$BASE/api/agents/$name/cancel" \
    -H "Content-Type: application/json" \
    -d '{"reason":"smoke cleanup"}' >/dev/null 2>&1 || true
}

# Spawn helpers -------------------------------------------------------

# 1. Roadmap template (single agent spawn) ----------------------------
test_roadmap() {
  # PID + epoch seconds for a unique name so two parallel smoke runs
  # never collide on the same spawn name. The backend rejects duplicate
  # names that already exist in cancelled state from prior runs.
  local name="demo-smoke-roadmap-$$-$(date +%s)"
  local spawn_resp
  spawn_resp=$($CURL -X POST "$BASE/api/agents/spawn" \
    -H "Content-Type: application/json" \
    -d "{\"name\":\"$name\",\"prompt\":\"Draft a 6-month roadmap for a notes app.\",\"model\":\"sonnet\",\"budget\":0.5,\"template\":\"roadmap\",\"demo_mode\":true,\"source\":\"smoke\"}" 2>&1)
  if ! echo "$spawn_resp" | grep -q '"pid"\|"result"'; then
    fail "roadmap template" "spawn failed: $(echo "$spawn_resp" | head -c 200)"
    return
  fi
  local elapsed
  elapsed=$(poll_agent "$name")
  cleanup_agent "$name"
  if [ "$elapsed" = "TIMEOUT" ]; then
    fail "roadmap template" "agent stayed running past ${POLL_S}s"
  elif (( elapsed > DEADLINE_S )); then
    fail "roadmap template" "took ${elapsed}s (cap ${DEADLINE_S}s)"
  else
    ok "roadmap template" "$elapsed"
  fi
}

# 2. PRD template (single agent spawn) --------------------------------
test_prd() {
  local name="demo-smoke-prd-$$-$(date +%s)"
  local spawn_resp
  spawn_resp=$($CURL -X POST "$BASE/api/agents/spawn" \
    -H "Content-Type: application/json" \
    -d "{\"name\":\"$name\",\"prompt\":\"Write a PRD for a recipe sharing site.\",\"model\":\"sonnet\",\"budget\":0.5,\"template\":\"prd\",\"demo_mode\":true,\"source\":\"smoke\"}" 2>&1)
  if ! echo "$spawn_resp" | grep -q '"pid"\|"result"'; then
    fail "prd template" "spawn failed: $(echo "$spawn_resp" | head -c 200)"
    return
  fi
  local elapsed
  elapsed=$(poll_agent "$name")
  cleanup_agent "$name"
  if [ "$elapsed" = "TIMEOUT" ]; then
    fail "prd template" "agent stayed running past ${POLL_S}s"
  elif (( elapsed > DEADLINE_S )); then
    fail "prd template" "took ${elapsed}s (cap ${DEADLINE_S}s)"
  else
    ok "prd template" "$elapsed"
  fi
}

# 3. Fleet build website (4 members, parallel, all in 90s) ------------
test_fleet_build_website() {
  local resp
  resp=$($CURL -X POST "$BASE/api/agents/fleets/spawn" \
    -H "Content-Type: application/json" \
    -d '{"fleet_id":"fleet-build-website","context":"demo smoke","model":"sonnet","budget":0.5}' 2>&1)
  local agents
  agents=$(echo "$resp" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for a in d.get('spawned', []):
    n = a.get('name')
    if n: print(n)
" 2>/dev/null)
  if [ -z "$agents" ]; then
    fail "fleet-build-website" "no agents spawned (resp: $(echo "$resp" | head -c 200))"
    return
  fi
  local started=$SECONDS
  local longest=0
  while (( SECONDS - started < POLL_S )); do
    local pending=0
    for a in $agents; do
      local status
      status=$($CURL "$BASE/api/agents" 2>/dev/null | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print('')
    sys.exit(0)
for x in d.get('agents', []):
    if x.get('name') == '$a':
        print(x.get('status',''))
        break
" 2>/dev/null)
      case "$status" in
        completed|completed_timeout|failed|cancelled|terminated_stale)
          ;;
        *)
          pending=$(( pending + 1 ))
          ;;
      esac
    done
    if (( pending == 0 )); then
      longest=$(( SECONDS - started ))
      break
    fi
    sleep 2
  done
  for a in $agents; do cleanup_agent "$a"; done
  if (( longest == 0 )); then
    fail "fleet-build-website" "members stayed running past ${POLL_S}s"
  elif (( longest > DEADLINE_S )); then
    fail "fleet-build-website" "slowest member ${longest}s (cap ${DEADLINE_S}s)"
  else
    ok "fleet-build-website (4 in parallel)" "$longest"
  fi
}

# 4. Daily standup workflow ------------------------------------------
test_daily_standup() {
  $CURL -X POST "$BASE/api/workflows/builtin-daily-standup/run" \
    -H "Content-Type: application/json" -d '{}' >/dev/null
  local elapsed
  elapsed=$(poll_workflow "builtin-daily-standup")
  if [ "$elapsed" = "TIMEOUT" ]; then
    fail "daily standup workflow" "stayed running past ${POLL_S}s"
  elif (( elapsed > DEADLINE_S )); then
    fail "daily standup workflow" "took ${elapsed}s (cap ${DEADLINE_S}s)"
  else
    ok "daily standup workflow" "$elapsed"
  fi
}

# 5. Weekly review workflow ------------------------------------------
test_weekly_review() {
  $CURL -X POST "$BASE/api/workflows/builtin-weekly-review/run" \
    -H "Content-Type: application/json" -d '{}' >/dev/null
  local elapsed
  elapsed=$(poll_workflow "builtin-weekly-review")
  if [ "$elapsed" = "TIMEOUT" ]; then
    fail "weekly review workflow" "stayed running past ${POLL_S}s"
  elif (( elapsed > DEADLINE_S )); then
    fail "weekly review workflow" "took ${elapsed}s (cap ${DEADLINE_S}s)"
  else
    ok "weekly review workflow" "$elapsed"
  fi
}

# 6. Spec decompose + build ------------------------------------------
test_spec_decompose_build() {
  local title="Demo Smoke Spec $$"
  local draft_resp
  draft_resp=$($CURL -X POST "$BASE/api/specs/draft" \
    -H "Content-Type: application/json" \
    -d "{\"title\":\"$title\"}" 2>/dev/null)
  local path
  path=$(echo "$draft_resp" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
r = d.get('result','').strip()
print(r)
" 2>/dev/null)
  if [ -z "$path" ]; then
    fail "spec decompose+build" "draft creation returned no path: $draft_resp"
    return
  fi
  local started=$SECONDS
  $CURL -X POST "$BASE/api/specs/decompose" \
    -H "Content-Type: application/json" \
    -d "{\"path\":\"$path\"}" >/dev/null
  local build_resp
  build_resp=$($CURL -X POST "$BASE/api/specs/$path/build" \
    -H "Content-Type: application/json" -d '{}' 2>/dev/null)
  local agents
  agents=$(echo "$build_resp" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for n in d.get('agents', []):
    print(n)
" 2>/dev/null)
  if [ -z "$agents" ]; then
    local elapsed=$(( SECONDS - started ))
    ok "spec decompose+build (no tasks)" "$elapsed"
    return
  fi
  local longest=0
  while (( SECONDS - started < POLL_S )); do
    local pending=0
    for a in $agents; do
      local status
      status=$($CURL "$BASE/api/agents" 2>/dev/null | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print('')
    sys.exit(0)
for x in d.get('agents', []):
    if x.get('name') == '$a':
        print(x.get('status',''))
        break
" 2>/dev/null)
      case "$status" in
        completed|completed_timeout|failed|cancelled|terminated_stale) ;;
        *) pending=$(( pending + 1 )) ;;
      esac
    done
    if (( pending == 0 )); then
      longest=$(( SECONDS - started ))
      break
    fi
    sleep 2
  done
  for a in $agents; do cleanup_agent "$a"; done
  $CURL -X DELETE "$BASE/api/specs/$path" >/dev/null 2>&1 || true
  if (( longest == 0 )); then
    fail "spec decompose+build" "builders stayed running past ${POLL_S}s"
  elif (( longest > DEADLINE_S )); then
    fail "spec decompose+build" "slowest builder ${longest}s (cap ${DEADLINE_S}s)"
  else
    ok "spec decompose+build" "$longest"
  fi
}

# 7. build_tasks_from chat tool --------------------------------------
test_build_tasks_from_file() {
  # Per-run unique seed: bypasses recent_deletes / open-task dedupe so
  # the chat tool always has fresh titles to register. Without this,
  # two back-to-back smoke runs leave every title in the tombstone
  # cache and the tool returns an empty batch.
  local seed="$HOME/.myos/files"
  mkdir -p "$seed"
  local stamp="$$-$(date +%s)"
  local f="$seed/demo-smoke-roadmap-${stamp}.md"
  cat > "$f" <<EOF
# Demo smoke roadmap ${stamp}

- e2e-land-basic-homepage-${stamp}
- e2e-add-contact-form-${stamp}
- e2e-newsletter-signup-${stamp}
- e2e-publish-staging-${stamp}
EOF
  local started=$SECONDS
  local resp
  resp=$($CURL -X POST "$BASE/api/chat/tools/run" \
    -H "Content-Type: application/json" \
    -d "{\"name\":\"build_tasks_from_file\",\"input\":{\"file_path\":\"$(basename "$f")\"}}" 2>&1)
  local elapsed=$(( SECONDS - started ))
  rm -f "$f"
  if echo "$resp" | grep -q '"result"\|Created\|tasks from'; then
    if (( elapsed > DEADLINE_S )); then
      fail "build tasks from file (chat)" "took ${elapsed}s (cap ${DEADLINE_S}s)"
    else
      ok "build tasks from file (chat)" "$elapsed"
    fi
  else
    fail "build tasks from file (chat)" "tool did not return a result (resp: $(echo "$resp" | head -c 200))"
  fi
}

# 8. build_it chat chain ---------------------------------------------
test_build_it_chain() {
  # Self-seed the recent batch so build_it never races a missing or
  # stale ~/.myos/last_task_batch.json from a prior smoke run. We hit
  # build_tasks_from_file synchronously first and only start the timer
  # after the seed lands, so the latency we report is purely the
  # build_it spawn-and-cap loop, not the seeding round trip.
  local seed="$HOME/.myos/files"
  mkdir -p "$seed"
  local stamp="$$-$(date +%s)"
  local f="$seed/demo-smoke-build-it-roadmap-${stamp}.md"
  cat > "$f" <<EOF
# Build it smoke seed ${stamp}

- e2e-build-feature-alpha-${stamp}
- e2e-build-feature-beta-${stamp}
EOF
  $CURL -X POST "$BASE/api/chat/tools/run" \
    -H "Content-Type: application/json" \
    -d "{\"name\":\"build_tasks_from_file\",\"input\":{\"file_path\":\"$(basename "$f")\"}}" \
    >/dev/null 2>&1
  rm -f "$f"
  local started=$SECONDS
  local resp
  resp=$($CURL -X POST "$BASE/api/chat/tools/run" \
    -H "Content-Type: application/json" \
    -d "{\"name\":\"build_from_recent_tasks\",\"input\":{}}" 2>&1)
  local agents
  agents=$(echo "$resp" | python3 -c "
import json, sys, re
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
result = d.get('result','') or ''
for name in re.findall(r'build-[a-zA-Z0-9_-]+', result):
    print(name)
" 2>/dev/null | sort -u)
  if [ -z "$agents" ]; then
    local elapsed=$(( SECONDS - started ))
    if echo "$resp" | grep -q "No recent task batch"; then
      ok "build it chain (no batch)" "$elapsed"
      return
    fi
    fail "build it chain" "no agents in response: $(echo "$resp" | head -c 200)"
    return
  fi
  local longest=0
  while (( SECONDS - started < POLL_S )); do
    local pending=0
    for a in $agents; do
      local status
      status=$($CURL "$BASE/api/agents" 2>/dev/null | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print('')
    sys.exit(0)
for x in d.get('agents', []):
    if x.get('name') == '$a':
        print(x.get('status',''))
        break
" 2>/dev/null)
      case "$status" in
        completed|completed_timeout|failed|cancelled|terminated_stale) ;;
        *) pending=$(( pending + 1 )) ;;
      esac
    done
    if (( pending == 0 )); then
      longest=$(( SECONDS - started ))
      break
    fi
    sleep 2
  done
  for a in $agents; do cleanup_agent "$a"; done
  if (( longest == 0 )); then
    fail "build it chain" "builders stayed running past ${POLL_S}s"
  elif (( longest > DEADLINE_S )); then
    fail "build it chain" "slowest builder ${longest}s (cap ${DEADLINE_S}s)"
  else
    ok "build it chain" "$longest"
  fi
}

# Run surfaces in parallel so the smoke wall-clock is bounded by the
# slowest single surface (not the sum). Each surface lives in its own
# subshell, writes its captured stdout to a label file, and appends
# its result line to the shared RESULT_FILE so the parent can rebuild
# the tally and table after the wait.
TMP="$(mktemp -d)"
# Keep tmp around when DEBUG_KEEP_TMP=1 so a failed run can be inspected
# after the smoke exits. Default cleanup keeps /var/folders tidy.
if [ "${DEBUG_KEEP_TMP:-}" = "1" ]; then
  echo "DEBUG_KEEP_TMP=1 -> keeping $TMP after exit"
else
  trap 'rm -rf "$TMP"' EXIT
fi
RESULT_FILE="$TMP/results.txt"
export RESULT_FILE
: > "$RESULT_FILE"

run_in_bg() {
  local label="$1"; shift
  ( "$@" ) > "$TMP/$label.out" 2>&1 &
}

# Order matters only for the final table.
ORDER=(roadmap prd fleet daily weekly spec build_tasks build_it)

# build_it depends on a fresh ``last_task_batch.json``. Run it serially
# up front so its self-seeding is the last writer to the batch file
# before the build spawn polls it. The other 7 surfaces stagger by
# 1.5s each to avoid an asyncio Unix transport race when 8 simultaneous
# claude CLI subprocess forks hit the backend at once.
test_build_it_chain > "$TMP/build_it.out" 2>&1

run_in_bg "build_tasks" test_build_tasks_from_file
sleep 1.5
run_in_bg "roadmap"     test_roadmap
sleep 1.5
run_in_bg "prd"         test_prd
sleep 1.5
run_in_bg "fleet"       test_fleet_build_website
sleep 1.5
run_in_bg "daily"       test_daily_standup
sleep 1.5
run_in_bg "weekly"      test_weekly_review
sleep 1.5
run_in_bg "spec"        test_spec_decompose_build
wait

# Stream each surface's captured output in declaration order so the
# table reads top-to-bottom in the same order it was scheduled.
for label in "${ORDER[@]}"; do
  if [ -s "$TMP/$label.out" ]; then
    cat "$TMP/$label.out"
  fi
done

# Rebuild the totals from the result file.
PASS=0
FAIL=0
RESULTS=()
while IFS= read -r line; do
  RESULTS+=("$line")
  case "$line" in
    PASS\|*) PASS=$(( PASS + 1 )) ;;
    FAIL\|*) FAIL=$(( FAIL + 1 )) ;;
  esac
done < "$RESULT_FILE"

echo ""
echo "=== test_all_demo_paths_under_90s: $PASS passed, $FAIL failed ==="
echo ""
echo "Per-surface latency table"
echo "-------------------------"
printf "%-40s  %-6s  %s\n" "surface" "result" "seconds"
for r in "${RESULTS[@]}"; do
  IFS='|' read -r kind label sec <<< "$r"
  printf "%-40s  %-6s  %s\n" "$label" "$kind" "$sec"
done
echo ""

if (( FAIL > 0 )); then
  echo "DEMO BUDGET BLOWN — fix the failing surfaces before going live."
  exit 1
fi
echo "DEMO BUDGET HELD — every surface landed inside ${DEADLINE_S}s."
exit 0
