# →650 first-run onboarding — ostk boot three-state output
FROM claude-sonnet-4-6
BOOT haystack boot --bail
PROMPT "Implement first-run onboarding for ostk boot. Three states: fresh install (no .haystack/), healthy, errors. See the full spec."
PROMPT file://../prompts/onboarding-boot.md
TOOL sh_run
TOOL ss
LIMIT context_pct 85
LIMIT budget_usd 5
WORK tags=onboarding,p0 priority>=P0
