# haystack n+2 — security + trust agent pool
# Focus: identity layer implementation, secret injection, trust tier enforcement
# Priority: options 2+3 from fleet status — T1 promotion + --env-passthrough

FROM claude-sonnet-4-6

IDENTITY haystack-security-pool
GOAL implement identity layers, enforce trust tiers, close →618-→624

TOOL sh_run
TOOL sh_spawn

LIMIT turns 40
LIMIT tokens 300000

BOOT read ~/projects/haystack/.haystack/boot.md
BOOT read ~/projects/haystack/docs/spec/identity-layers.md

# Priority queue (ordered by security impact):
# 1. →619: boot reads harness_identity → alias assignment (DONE in 12d3906)
# 2. →620: GenTable writer_email attribution
# 3. →621: TrustTier enforced at secret resolution
# 4. →622: HUMANFILE verified_identities registry
# 5. --env-passthrough: HUMANFILE.secrets authorization gate

COORDINATE filesystem
STATE ~/projects/haystack/.haystack/

# --- SECURITY EXPERT ROLE ---
# One agent in the pool runs as security reviewer, not implementer.
# It does NOT write code. It reads implementations and files threat model findings
# as haystack needles for the implementing agents to action.
#
# AGENT security-review
#   GOAL: threat model everything shipped in this pool
#   SCOPE: identity-layers, bail, --env-passthrough, trust tiers, HUMANFILE.secrets
#   OUTPUT: haystack needles (P0/P1 security findings) + docs/security/threat-model.md
#   CONSTRAINT: read-only on src/ — write only to docs/ and .haystack/needles/
#
# Threat model scope:
#   - harness_identity in boot.md: can an attacker tamper before kernel reads it?
#   - bail package: path traversal in unpack? manifest injection?
#   - --env-passthrough: HUMANFILE.secrets parsing injection? key name injection?
#   - TrustTier: can T2 agent claim T1? race between read and tier assignment?
#   - HUMANFILE: can it be modified after GPG signature to add unauthorized secrets?
#   - os.bin encryption: what happens if GPG key is absent — does it fail open or closed?
