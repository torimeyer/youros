# llmOS concurrency pool — implements docs/spec/llmos-concurrency.md
# Thread: llmOS-concurrency — →628 →629 →620 →619
FROM claude-sonnet-4-6
BOOT haystack boot --bail
PROMPT "Implement llmOS concurrency spec. Thread: llmOS-concurrency."
PROMPT file://../prompts/llmOS-concurrency.md
PROMPT file://../docs/spec/llmos-concurrency.md
TOOL sh_run
TOOL sh_spawn
TOOL ss
LIMIT context_pct 85
LIMIT budget_usd 10
WORK tags=scheduler,concurrency priority>=P1
