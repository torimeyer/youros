# governance docs — ostk.ai: HUMANFILE, ENTITYFILE, Agentfile, OSfile
FROM claude-opus-4-6
BOOT haystack boot --bail
PROMPT "Write four governance documentation pages for the ostk.ai product site at ~/projects/ostk-site. These are governance references — how operators govern their use of the OS. NOT how the OS works internally."
PROMPT file://../prompts/governance-docs-writer.md
TOOL sh_run
TOOL ss
LIMIT context_pct 85
LIMIT budget_usd 8
WORK tags=docs,ostk-site,governance priority>=P1
