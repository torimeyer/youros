# .mcp.json is gitignored because it contains a per-user Stitch API key.
# The tracked template is .mcp.json.example. install.sh copies it into
# place on first install so every user gets a working config skeleton
# with their own key pasted in. Never commit .mcp.json itself.
.mcp.json
lego-app/
taxes/
transcripts/
workspaces/
.coverage
coverage/
e2e-screenshots/*.png

# User-local specs live in ~/.myos/specs/, not in the repo (→1377)
# Use `ostk doc promote` to write there; never commit docs/spec/ contents.
docs/spec/

# NR-internal strategy content should live outside the repo (~/.myos/) — never commit
nr-workspaces-saved/
frontend/test-results/

# ostk-cache local telemetry — never committed
.ostk/memory/ledger.jsonl
.ostk/rewrite-events.jsonl
.ostk/file_cache.jsonl
.l1.5/

docs/spec/

# user runtime data (custom verbs, etc.) — not committed
config/

# transient scratch dumps (Drive exports, session notes); never commit
.tmp/

# User-local specs and drafts live in ~/.myos/specs/. Never commit (->1377, fresh-install leak).
# Use `ostk doc draft` / `ostk doc promote`; never commit docs/spec or docs/draft contents.
docs/spec/
docs/draft/

# Session/user working-state that must never reach the public repo (→privacy)
# Verified gaps 2026-06-03: these were NOT covered before.
.ostk/needles/
docs/superpowers/
