<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.myos.backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/scripts/dev-backend.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>MYOS_NO_WATCHDOG</key>
        <string>1</string>
        <key>MYOS_FORCE_RESTART</key>
        <string>1</string>
        <key>RELEASE_MODE</key>
        <string>1</string>
        <key>PORT</key>
        <string>8000</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>1</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.myos/logs/backend.out</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.myos/logs/backend.err</string>
</dict>
</plist>
