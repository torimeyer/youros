<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.youros.watchdog.plist.template
  Rendered by install.sh into ~/Library/LaunchAgents/com.youros.watchdog.plist.
  Placeholders: __INSTALL_DIR__ __HOME__ __HEALTH_URL__

  Runs the watchdog in KILL_ONLY mode: if the backend's event loop is
  deadlocked (PID alive but /api/health fails repeatedly), the watchdog
  sends SIGKILL. launchd (com.youros.backend, KeepAlive=true) then restarts
  uvicorn sub-second. The watchdog never starts uvicorn itself.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.youros.watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__INSTALL_DIR__/scripts/backend_watchdog.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__INSTALL_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>MYOS_WATCHDOG_KILL_ONLY</key>
        <string>1</string>
        <key>MYOS_WATCHDOG_INTERVAL</key>
        <string>5</string>
        <key>MYOS_WATCHDOG_HEALTH_URL</key>
        <string>__HEALTH_URL__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/.youros/logs/watchdog.out</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.youros/logs/watchdog.err</string>
</dict>
</plist>
